rules_version = '2';
// Règles de sécurité Firestore pour EspañolSprint.
// À déployer depuis la console Firebase (Firestore → Règles) ou avec : firebase deploy --only firestore:rules
//
// Principe : un utilisateur ne peut lire et modifier que son propre profil, et il ne peut JAMAIS
// modifier lui-même son abonnement (subscription) ni son quota IA (aiUsage) : seuls les serveurs
// (routes /api, via le compte de service) écrivent ces champs.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;

      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.subscription.status == 'free'
        && !('aiUsage' in request.resource.data);

      allow update: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['subscription', 'aiUsage']);
    }

    // Contenu des leçons : lecture pour les utilisateurs connectés, écriture réservée à l'administrateur.
    // Remplace l'adresse ci-dessous par la tienne (la même que NEXT_PUBLIC_ADMIN_EMAILS).
    match /meta/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == 'ADMIN_EMAIL_A_REMPLACER';
    }
    match /lessons/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == 'ADMIN_EMAIL_A_REMPLACER';
    }
  }
}
