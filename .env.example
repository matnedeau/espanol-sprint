# --- Site ---
NEXT_PUBLIC_SITE_URL=https://espanol-sprint.vercel.app
# Adresse(s) e-mail ayant accès au bouton d'administration (séparées par des virgules)
NEXT_PUBLIC_ADMIN_EMAILS=

# --- Firebase ---
NEXT_PUBLIC_FIREBASE_API_KEY=
# JSON complet du compte de service (Firebase → Paramètres du projet → Comptes de service)
FIREBASE_SERVICE_ACCOUNT_KEY=

# --- IA ---
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# --- Stripe ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID=
# Webhook : URL https://<ton-site>/api/webhook, événements checkout.session.completed,
# customer.subscription.updated et customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=
# Offre annuelle (facultatif) : crée un second prix dans Stripe puis active l'affichage
STRIPE_PRICE_ID_YEARLY=
NEXT_PUBLIC_STRIPE_YEARLY_ENABLED=false
NEXT_PUBLIC_YEARLY_PRICE_LABEL=39,99 €

# --- Codes d'accès Premium offerts (séparés par des virgules) ---
VIP_CODES=
